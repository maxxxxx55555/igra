extends Node

signal grid_updated(voltage: float)
signal substation_activated(district_id: String)
signal district_restored(district_id: String)
signal all_restored()

var grid_voltage: float = 0.0
var active_substations: int = 0
var total_substations: int = 8
var restored_districts: int = 0
var total_districts: int = 11

var districts: Dictionary = {
	"suburb":      {"name": "Пригород",            "restore": 72, "threat": "low"},
	"residential": {"name": "Жилые кварталы",      "restore": 48, "threat": "medium"},
	"park":        {"name": "Парк",                "restore": 35, "threat": "medium"},
	"school":      {"name": "Школа",               "restore": 15, "threat": "high"},
	"hospital":    {"name": "Больница",            "restore": 20, "threat": "high"},
	"police":      {"name": "Полицейский участок", "restore": 60, "threat": "medium"},
	"warehouse":   {"name": "Складской комплекс",  "restore": 10, "threat": "critical"},
	"substation":  {"name": "Подстанция",          "restore": 25, "threat": "high"},
	"industrial":  {"name": "Промышленная зона",   "restore": 5,  "threat": "critical"},
	"powerplant":  {"name": "Электростанция",      "restore": 0,  "threat": "critical"},
	"gasstation":  {"name": "АЗС",                 "restore": 40, "threat": "medium"},
}

var substations: Dictionary = {
	"sub_01": {"district": "suburb",      "active": true,  "requires": []},
	"sub_02": {"district": "residential", "active": true,  "requires": ["cable"]},
	"sub_03": {"district": "police",      "active": true,  "requires": ["fuse"]},
	"sub_04": {"district": "park",        "active": false, "requires": ["cable", "fuse"]},
	"sub_05": {"district": "hospital",    "active": false, "requires": ["cable", "fuse"]},
	"sub_06": {"district": "school",      "active": false, "requires": ["cable"]},
	"sub_07": {"district": "warehouse",   "active": false, "requires": ["cable", "fuse"]},
	"sub_08": {"district": "powerplant",  "active": false, "requires": ["cable", "fuse"]},
}

func _ready() -> void:
	_recalc()



func _recalc() -> void:
	active_substations = 0
	for sid in substations:
		if "active" in substations[sid] and substations[sid].active:
			active_substations += 1
	grid_voltage = (float(active_substations) / float(total_substations)) * 100.0
	restored_districts = 0
	for did in districts:
		if "restore" in districts[did] and districts[did].restore >= 100:
			restored_districts += 1
	grid_updated.emit(grid_voltage)

func activate_substation(sid: String) -> bool:
	if not substations.has(sid):
		return false
	if "active" in substations[sid] and substations[sid].active:
		return true
	var req: Array = substations[sid].requires if "requires" in substations[sid] else []
	var inv := get_node_or_null("/root/InventoryManager")
	for r in req:
		if inv and inv.has_method("has") and not inv.has(r):

			return false
	substations[sid].active = true
	var did: String = substations[sid].district if "district" in substations[sid] else ""
	if districts.has(did):
		districts[did].restore = mini(100, districts[did].restore + 34)
		if "restore" in districts[did] and districts[did].restore >= 100:
			district_restored.emit(did)
	_recalc()
	substation_activated.emit(did)

	if active_substations >= total_substations:
		all_restored.emit()

	return true

func is_district_lit(did: String) -> bool:
	if districts.has(did):
		return "restore" in districts[did] and districts[did].restore >= 60
	return false

func get_restore(did: String) -> int:
	if districts.has(did) and "restore" in districts[did]:
		return districts[did].restore
	return 0

func get_threat(did: String) -> String:
	if districts.has(did) and "threat" in districts[did]:
		return districts[did].threat
	return "unknown"

func serialize() -> Dictionary:
	return {"substations": substations.duplicate(true), "districts": districts.duplicate(true)}

func deserialize(d: Dictionary) -> void:
	if "substations" in d:
		substations = d.substations
	if "districts" in d:
		districts = d.districts
	_recalc()