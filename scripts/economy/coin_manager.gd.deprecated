extends Node
## A5: CoinManager - edinaja valjuta + HUD

signal coins_changed(amount: int)

var coins: int = 0

func _ready() -> void:
    _load()

func add(n: int) -> void:
    coins += n; coins_changed.emit(coins); _save()

func spend(n: int) -> bool:
    if coins < n: return false
    coins -= n; coins_changed.emit(coins); _save(); return true

func _save() -> void:
    var f = FileAccess.open("user://coins.cfg", FileAccess.WRITE)
    if f: f.store_string(str(coins))

func _load() -> void:
    if FileAccess.file_exists("user://coins.cfg"):
        var f = FileAccess.open("user://coins.cfg", FileAccess.READ)
        if f: coins = int(f.get_as_text().strip_edges())