== script sc_rev.sh
#!/usr/bin/env bash
# Round 6 / CORRECTION_LOG 138: shellcheck -S warning over every shell script of a revision, with the file filter and the options of tools/utilities_report.sh.
# usage: sc_rev.sh <rev>. The files are read with git show, nothing is written.
cd C:/Users/Maxsim/Desktop/TLS_Build/THE_LAST_STREETLIGHT || exit 2
rev="${1:?rev}"
SC="C:/Users/Maxsim/AppData/Roaming/Python/Python311/Scripts/shellcheck.exe"
[[ -x "$SC" ]] || { echo "shellcheck not found at $SC"; exit 3; }
files=0
hits=0
while IFS= read -r f; do
	case "$f" in *.sh | tools/hooks/* | tools/qa_sim/*) ;; *) continue ;; esac
	[[ "$f" == *.* && "$f" != *.sh ]] && continue
	files=$((files + 1))
	out="$(git show "$rev:$f" | tr -d '\r' | "$SC" -s bash -f gcc -S warning - 2>&1 | sed "s#^-:#$f:#")"
	[[ -n "$out" ]] && { echo "$out"; hits=$((hits + $(echo "$out" | wc -l))); }
done < <(git ls-tree -r --name-only "$rev")
echo "revision $rev: shellcheck files=$files findings=$hits"
