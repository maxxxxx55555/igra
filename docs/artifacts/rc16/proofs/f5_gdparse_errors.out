== script gdparse_errors.py
"""Where does the gdtoolkit parser stop in the named GDScript files? gdparse_errors.py <repo-root> <file>..."""
import pathlib
import sys

from gdtoolkit.parser import parser

root = pathlib.Path(sys.argv[1])
for name in sys.argv[2:]:
    source = (root / name).read_text(encoding="utf-8")
    try:
        parser.parse(source, gather_metadata=False)
        print("%s: parses" % name)
    except Exception as err:
        text = str(err).splitlines()
        where = getattr(err, "line", None)
        column = getattr(err, "column", None)
        line_text = source.splitlines()[where - 1].strip()[:90] if where else ""
        print("%s: line %s column %s | %s | %s" % (name, where, column, line_text, text[0][:80] if text else ""))
