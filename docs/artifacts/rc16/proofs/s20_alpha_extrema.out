"""Session 20 (W2): is the alpha channel of each RGBA store image fully opaque (minimum 255)? Then dropping it (convert("RGB")) loses nothing.
Read-only; prints itself first. usage: python -I s20_alpha_extrema.py <repo>"""
import pathlib
import sys

from PIL import Image

print(pathlib.Path(__file__).read_text(encoding="utf-8"))
print("--- run")
root = pathlib.Path(sys.argv[1])
paths = [root / "store/feature-graphic.png", root / "store/icon-512.png", *sorted((root / "docs/stills/release").glob("*.png"))]
bad = 0
for p in paths:
    with Image.open(p) as im:
        mode = im.mode
        low = im.getchannel("A").getextrema()[0] if "A" in mode else None
    print("%-70s mode=%-5s alpha_min=%s" % (p.relative_to(root).as_posix(), mode, low))
    bad += low is not None and low < 255
print("images with a transparent pixel: %d" % bad)
sys.exit(1 if bad else 0)

