"""Session 26 (C4): which documents of docs/ (top level) does nothing else name? For each docs/*.md: the files that name it (by its file name), the date of its last
commit, and its size. A document named by no other tracked text file, last touched before the tag v8.0.0-shipping (2026-10-12), is a stale candidate. Read-only.
Prints itself first. usage: python -I s26_stale_docs.py <repo>"""
import pathlib
import re
import subprocess
import sys

print(pathlib.Path(__file__).read_text(encoding="utf-8"))
print("--- run")
root = pathlib.Path(sys.argv[1]).resolve()


def git(*a):
    return subprocess.run(["git", *a], cwd=root, capture_output=True, text=True, encoding="utf-8", errors="replace").stdout


tracked = [t for t in git("ls-files").split("\n") if t]
TEXT = (".md", ".py", ".gd", ".sh", ".yml", ".yaml", ".json", ".tsv", ".cfg", ".tscn", ".tres", ".txt", ".godot", ".ps1")
corpus = {}
for t in tracked:
    if t.endswith(TEXT) and not t.startswith(("docs/stills/", "docs/shots/")):
        try:
            corpus[t] = (root / t).read_text(encoding="utf-8", errors="replace")
        except OSError:
            pass
docs = sorted(t for t in tracked if t.startswith("docs/") and t.endswith(".md") and t.count("/") == 1)
rows = []
for d in docs:
    name = d.rsplit("/", 1)[1]
    pat = re.compile(r"(?<![A-Za-z0-9_])" + re.escape(name))
    refs = [f for f, txt in corpus.items() if f != d and pat.search(txt)]
    date = git("log", "-1", "--format=%cs", "--", d).strip()
    rows.append((d, len(refs), date, (root / d).stat().st_size, refs[:2]))
print("documents at the top level of docs/: %d" % len(rows))
stale = [r for r in rows if r[1] == 0]
print("named by no other tracked text file: %d" % len(stale))
for d, n, date, size, _ in stale:
    print("%-48s last commit %s  %7d bytes" % (d, date, size))
old = [r for r in stale if r[2] < "2026-10-12"]
print("of those last touched before 2026-10-12: %d" % len(old))
print("--- named by exactly one file (candidates for a second look)")
for d, n, date, size, refs in rows:
    if n == 1 and date < "2026-10-12":
        print("%-48s %s  %7d bytes  by %s" % (d, date, size, refs[0]))

