"""Session 26: every windowed reading of the Music bus peak that the committed logs hold (the `[audio-truth] Music bus peak=` line of each attached gate log of the proofs of rc16 and the
sign-off log of rc15), one row per log,
split at the gate's ceiling of -1.5 dB. The readings after the limiter of default_bus_layout.tres are listed apart. Read-only; prints itself first.
usage: python -I s26_audio_readings.py <repo>"""
import glob
import pathlib
import re
import sys

print(pathlib.Path(__file__).read_text(encoding="utf-8"))
print("--- run")
root = pathlib.Path(sys.argv[1]).resolve()
rows = []
for f in sorted(glob.glob(str(root / "docs" / "artifacts" / "rc16" / "proofs" / "*.attach.*")) + glob.glob(str(root / "docs" / "artifacts" / "rc15" / "audio_truth_signoff.txt"))):
    p = pathlib.Path(f)
    text = re.sub(r"\x1b\[[0-9;]*m", "", p.read_text(encoding="utf-8", errors="replace"))
    for m in re.finditer(r"\[audio-truth\] Music bus peak=(-?[0-9.]+)dB", text):
        rows.append((p.name, float(m.group(1))))
before = [r for r in rows if not r[0].startswith("s26b_")]
after = [r for r in rows if r[0].startswith("s26b_")]
for name, db in before:
    print("%-96s %+6.1f dB  %s" % (name, db, "OVER" if db > -1.5 else "under"))
over = [r for r in before if r[1] > -1.5]
print("readings before the limiter: %d, over the ceiling %d (%+.1f to %+.1f dB), under it %d (%.1f to %.1f dB)" % (
    len(before), len(over), min(r[1] for r in over), max(r[1] for r in over), len(before) - len(over),
    min(r[1] for r in before if r[1] <= -1.5), max(r[1] for r in before if r[1] <= -1.5)))
for name, db in after:
    print("after the limiter: %s %+.1f dB" % (name, db))

