   shellpipe L212: omniroute eval list --json
   shellpipe L214: omniroute eval get <runId>                       # Run details (status, model, score)
   shellpipe L215: omniroute eval results <runId>                   # Per-sample results
   shellpipe L216: omniroute eval scorecard <runId>                 # Full scorecard with pass/fail per sample
   shellpipe L217: omniroute eval cancel <runId>                    # Cancel a running eval
