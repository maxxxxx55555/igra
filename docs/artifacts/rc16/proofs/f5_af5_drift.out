== script af5_drift.py
"""Citation drift: for each citation in the AF5 scope, compare the cited lines as they were at the commit that last changed the document line (git blame)
with the same lines at HEAD. A difference means the code moved or changed after the sentence was written; every flag is read by hand.
usage: af5_drift.py <repo-root>"""
import importlib.util
import pathlib
import subprocess
import sys

root = pathlib.Path(sys.argv[1])
spec = importlib.util.spec_from_file_location("af5", root / "tools" / "af5_check.py")
af5 = importlib.util.module_from_spec(spec)
spec.loader.exec_module(af5)


def git(*args):
    r = subprocess.run(["git", *args], cwd=root, capture_output=True, text=True, encoding="utf-8", errors="replace")
    return r.stdout


flags, total = [], 0
for doc, number, text in af5.added_lines("e4bb4df"):
    for m in af5.CITE.finditer(text):
        path = af5.resolve(m.group("path"))
        if path is None:
            continue
        total += 1
        blame = git("blame", "--porcelain", "-L", "%d,%d" % (number, number), "--", doc).split(" ", 1)[0]
        if not blame or set(blame) == {"0"}:
            continue
        old = git("show", "%s:%s" % (blame, path)).replace("\r\n", "\n").split("\n")
        new = (root / path).read_text(encoding="utf-8", errors="replace").replace("\r\n", "\n").split("\n")
        for part in m.group("spec").split(","):
            a, b = (int(x) for x in (part.split("-") * 2)[:2])
            was, now = [s.strip() for s in old[a - 1:b]], [s.strip() for s in new[a - 1:b]]
            if was != now:
                flags.append((doc, number, m.group(0), blame[:7], " / ".join(was)[:90], " / ".join(now)[:90]))
                break

for doc, number, cite, blame, was, now in flags:
    print("%s:%d | %s | blame %s | WAS: %s | NOW: %s" % (doc, number, cite, blame, was, now))
print("citations checked: %d, flagged: %d" % (total, len(flags)))
