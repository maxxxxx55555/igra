"""Session 26 (export 2): the size of a bundle by top-level folder, compressed bytes per group, and the packed bus layout of the Music bus: how many times the layout
names the limiter, the compressor and the reverb. Read-only; prints itself first. usage: python -I -B s26_aab_sizes.py <bundle.aab>"""
import collections
import pathlib
import sys
import zipfile

print(pathlib.Path(__file__).read_text(encoding="utf-8"))
print("--- run")
z = zipfile.ZipFile(sys.argv[1])
size = collections.Counter()
count = collections.Counter()
for i in z.infolist():
    group = i.filename.split("/")[0]
    size[group] += i.compress_size
    count[group] += 1
print(len(z.infolist()), "entries")
for group in sorted(size):
    print(group, count[group], "entries", size[group], "compressed bytes")
for i in z.infolist():
    if "default_bus_layout" in i.filename and i.filename.endswith(".res"):
        d = z.read(i.filename)
        print(i.filename.rsplit("/", 1)[-1], i.file_size, "bytes; mentions of AudioEffectHardLimiter:", d.count(b"AudioEffectHardLimiter"),
              "; of AudioEffectCompressor:", d.count(b"AudioEffectCompressor"), "; of AudioEffectReverb:", d.count(b"AudioEffectReverb"))

