== script msg_len.py
"""Length of the af5_check message of tools/check.sh before and after commit 30363f8, and of the shortened variant the ponytail-review named."""
import re
import subprocess


def message(rev):
    text = subprocess.run(["git", "show", "%s:tools/check.sh" % rev], capture_output=True, text=True, encoding="utf-8").stdout
    m = re.search(r'ok "(af5_check \([^"]*\))"', text)
    return m.group(1)


short = "af5_check (cited lines exist, and match a backticked claim when one is given)"
for name, s in (("before 30363f8", message("30363f8^")), ("at 30363f8", message("30363f8")), ("shortened variant", short)):
    print("%-18s %3d characters | %s" % (name, len(s), s))
