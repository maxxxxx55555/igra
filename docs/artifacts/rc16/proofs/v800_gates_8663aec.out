#!/usr/bin/env bash
# The static gates of the v8.0.0 release, each with its own exit code, and a compare of the store titles and taglines with the shipped strings. Prints itself first.
cat "$0"
echo "--- run"
gate() { echo "=== $*"; "$@" 2>&1 | tail -3; echo "exit=${PIPESTATUS[0]}"; }
gate python tools/qa_sim/i18n_truth_gate.py
gate python tools/i18n_audit.py
gate python tools/qa_sim/hardcoded_text_gate.py
gate python tools/gen_store_listing_locales.py --check
gate python tools/flow_check.py
gate python tools/scene_node_check.py
gate python tools/lint_changed.py
gate python tools/af5_check.py
gate python tools/qa_sim/af3_frame_check.py
echo "=== store titles and taglines against menu_title and menu_subtitle"
python -I - <<'PY'
import json
import pathlib
import re

text = pathlib.Path("store/listing.md").read_text(encoding="utf-8")
blocks = re.split(r"^### ", text, flags=re.M)[1:]
same = diff = 0
for block in blocks:
    head = block.split("\n", 1)[0]
    loc = head.split(" ", 1)[0]
    path = pathlib.Path("data/i18n") / (loc + ".json")
    if not path.exists():
        continue
    strings = json.loads(path.read_text(encoding="utf-8"))
    for field, key in (("Title", "menu_title"), ("Tagline", "menu_subtitle")):
        m = re.search(r"^- \*\*" + field + r":\*\* (.+)$", block, flags=re.M)
        if m is None:
            continue
        if m.group(1).strip() == strings.get(key, ""):
            same += 1
        else:
            diff += 1
            print("differs", loc, field, repr(m.group(1).strip()), "vs", repr(strings.get(key, "")))
print("store fields equal to the game strings:", same, "differing:", diff)
PY
