== script f5_duration_sweep.py
"""F5 round 7 / CORRECTION_LOG 140, re-run for row 144: the duration figures (a number with min, minutes, h, hours, s or seconds) in the document lines
added between e4bb4df and a given commit, outside CORRECTION_LOG.md and RUN_STATE.md; every hit is printed to be read.
usage: python f5_duration_sweep.py <repo-root> <commit>
"""
import re
import subprocess
import sys

root, head = sys.argv[1], sys.argv[2]


def git(*args):
    return subprocess.run(["git", *args], cwd=root, capture_output=True, text=True, encoding="utf-8", errors="replace").stdout


docs = [d for d in git("diff", "--name-only", "e4bb4df", head, "--", "docs", "opencode-memory.md").split("\n")
        if d.endswith(".md") and not d.startswith(("docs/artifacts/", "docs/stills/")) and not d.endswith(("CORRECTION_LOG.md", "RUN_STATE.md"))]
pat = re.compile(r"(?<![\w.])(\d+(?:\.\d+)?)(?:\s?[-\u2013]\s?\d+(?:\.\d+)?)?\s?(minutes?|min|hours?|h\b|seconds?|\bs\b)(?!\w)")
n = 0
for d in docs:
    for line in git("diff", "-U0", "e4bb4df", head, "--", d).splitlines():
        if not line.startswith("+") or line.startswith("+++"):
            continue
        for m in pat.finditer(line):
            n += 1
            print("%s | ...%s" % (d.replace("docs/", ""), line[max(0, m.start() - 70):min(len(line), m.end() + 40)]))
print("commit", head, "hits", n)
