"""Session 26 (C1): the fresh dead-asset manifest of the tracked files under assets/, by the two patterns of docs/SIZE_BUDGET.md and what that document learned the hard
way. A file is
  KEEP-LIVE      named by a full path (pattern A) or a basename (pattern B) in the runtime corpus (scripts/, scenes/, data/, content/, addons/, project.godot,
                 export_presets.cfg, default_bus_layout.tres; not scripts/tools, scenes/tools), or matched by a format string the runtime builds a path with (%s, %d),
                 or inside a directory the runtime lists or prefixes (DirAccess, "res://assets/x/" + id)
  KEEP-QA        named only by the tools (scripts/tools, scenes/tools, tools/): not shipped data, kept for the checks that load it
  KEEP-PLANNED   named in a document that is not a log of what was done (the first citation is printed)
  UNCERTAIN      its stem (the name without extension) occurs in the runtime corpus, or the export filter ships it and only a log of what was done names it
  AUTO-DELETE    none of the above
The export filter (first preset) says whether the bundle holds the file. Read-only. Prints itself first; writes the TSV when given a path.
usage: python -I s26_manifest.py <repo> [<tsv>]"""
import collections
import fnmatch
import pathlib
import re
import subprocess
import sys

print(pathlib.Path(__file__).read_text(encoding="utf-8"))
print("--- run")
root = pathlib.Path(sys.argv[1]).resolve()
tsv = pathlib.Path(sys.argv[2]) if len(sys.argv) > 2 else None


def git(*a):
    return subprocess.run(["git", *a], cwd=root, capture_output=True, text=True, encoding="utf-8", errors="replace").stdout


tracked = [t for t in git("ls-files").split("\n") if t]
assets = [t for t in tracked if t.startswith("assets/") and not t.endswith((".import", ".uid"))]
TEXT = (".gd", ".tscn", ".tres", ".cfg", ".json", ".godot", ".gdshader", ".shader", ".csv", ".txt")
runtime_files, tool_files, doc_files = [], [], []
for t in tracked:
    if t.endswith(".import"):
        continue
    if t.startswith(("scripts/tools/", "scenes/tools/", "tools/")) and t.endswith(TEXT + (".py", ".sh")):
        tool_files.append(t)
    elif t.startswith(("scripts/", "scenes/", "data/", "content/", "addons/")) and t.endswith(TEXT) or t in ("project.godot", "export_presets.cfg", "default_bus_layout.tres"):
        runtime_files.append(t)
    elif t.endswith(".md") and (t.startswith("docs/") or t.startswith("store/") or "/" not in t):
        doc_files.append(t)
LOGS = ("docs/RUN_STATE.md", "docs/CORRECTION_LOG.md", "docs/PROOFS.md", "docs/RESUME_NOTE.md", "docs/ORDER_PASS_REPORT.md", "docs/CLEANUP_LEDGER.md", "docs/CLEANUP_LOG.md",
        "docs/CLEANUP_MANIFEST.md", "docs/ABSORB_PLAN.md", "docs/GEMINI_INTEGRATION_REPORT.md", "docs/SIZE_BUDGET.md", "docs/QUARANTINE_AUDIT.md", "docs/SURFACES_UI_NARROWING.md",
        "docs/KNOWN_ISSUES.md", "docs/RELEASE_ARTIFACTS.md", "docs/ASSET_LICENSES.md", "docs/SLOP_REPORT.md", "docs/SLOP_REPORT_V2.md")
docs = [d for d in doc_files if d not in LOGS and not d.startswith("docs/artifacts/")]


def read(p):
    return (root / p).read_text(encoding="utf-8", errors="replace")


rt = "\n".join(read(p) for p in runtime_files)
tl = "\n".join(read(p) for p in tool_files)
doc_text = {d: read(d) for d in docs}
excludes = []
m = re.search(r'^exclude_filter="([^"]*)"', read("export_presets.cfg"), re.M)
if m:
    excludes = [x.strip() for x in m.group(1).split(",") if x.strip()]


def shipped(path):
    return not any(fnmatch.fnmatchcase(path, pat) for pat in excludes)


full_paths = set(re.findall(r"assets/[A-Za-z0-9_./ -]+\.[A-Za-z0-9]+", rt))
# format strings and prefixes the runtime builds a path with
dyn_re, prefixes = [], set()
for lit in re.findall(r'"(res://assets/[^"]*)"', rt):
    p = lit[len("res://"):]
    if "%" in p:
        dyn_re.append(re.compile("^" + re.sub(r"%\d*[sd]", "[A-Za-z0-9_]+", re.escape(p).replace("\\%", "%")) + "$"))
for pre in re.findall(r'"res://(assets/[^"]*/)"\s*\+', rt):
    prefixes.add(pre)
for pre in re.findall(r'(?:DirAccess\.open|list_dir|get_files_at|dir_contents)\([^)]*"res://(assets/[^"]*)"', rt):
    prefixes.add(pre if pre.endswith("/") else pre + "/")
words_rt = set(re.findall(r"[A-Za-z0-9_.\-]+\.[A-Za-z0-9]+", rt))
words_tl = set(re.findall(r"[A-Za-z0-9_.\-]+\.[A-Za-z0-9]+", tl))
rows, counts, mb = [], collections.Counter(), collections.Counter()
for a in sorted(assets):
    base = a.rsplit("/", 1)[-1]
    stem = base.rsplit(".", 1)[0]
    size = (root / a).stat().st_size if (root / a).exists() else 0
    why = ""
    if a in full_paths:
        v, why = "KEEP-LIVE", "pattern A"
    elif base in words_rt:
        v, why = "KEEP-LIVE", "pattern B"
    elif any(r.match(a) for r in dyn_re):
        v, why = "KEEP-LIVE", "format string"
    elif any(a.startswith(pre) for pre in prefixes):
        v, why = "KEEP-LIVE", "directory the runtime lists or prefixes"
    elif base in words_tl or a in tl:
        v, why = "KEEP-QA", "named by a tool"
    else:
        cite = ""
        for d, txt in doc_text.items():
            for n, line in enumerate(txt.splitlines(), 1):
                if base in line or a in line:
                    cite = "%s:%d" % (d, n)
                    break
            if cite:
                break
        if cite:
            v, why = "KEEP-PLANNED", cite
        elif re.search(r"(?<![A-Za-z0-9_])" + re.escape(stem) + r"(?![A-Za-z0-9_])", rt):
            v, why = "UNCERTAIN", "stem in the runtime corpus"
        else:
            v, why = "AUTO-DELETE", "none"
    rows.append((a, v, why, size, "yes" if shipped(a) else "no"))
    counts[v] += 1
    mb[v] += size
print("tracked assets: %d; runtime corpus %d files, tools %d, planning documents %d; dynamic patterns %d, prefixes %d; export exclude patterns %d"
      % (len(assets), len(runtime_files), len(tool_files), len(docs), len(dyn_re), len(prefixes), len(excludes)))
for v in ("KEEP-LIVE", "KEEP-QA", "KEEP-PLANNED", "UNCERTAIN", "AUTO-DELETE"):
    print("%-13s %5d files %9.1f MB (shipped: %d)" % (v, counts[v], mb[v] / 1048576, sum(1 for r in rows if r[1] == v and r[4] == "yes")))
by_dir = collections.defaultdict(lambda: collections.Counter())
for a, v, _, _, _ in rows:
    by_dir["/".join(a.split("/")[:3])][v] += 1
print("--- by directory (not KEEP-LIVE only)")
for d, c in sorted(by_dir.items()):
    rest = {k: n for k, n in c.items() if k != "KEEP-LIVE"}
    if rest:
        print("%-44s live %4d  %s" % (d, c["KEEP-LIVE"], ", ".join("%s %d" % kv for kv in sorted(rest.items()))))
print("--- AUTO-DELETE")
for a, v, _, size, sh in rows:
    if v == "AUTO-DELETE":
        print("%9d  shipped=%-3s %s" % (size, sh, a))
print("--- UNCERTAIN")
for a, v, why, size, sh in rows:
    if v == "UNCERTAIN":
        print("%9d  shipped=%-3s %s" % (size, sh, a))
if tsv:
    tsv.write_text("path\tverdict\twhy\tbytes\tshipped\n" + "\n".join("%s\t%s\t%s\t%d\t%s" % r for r in rows) + "\n", encoding="utf-8", newline="\n")
    print("wrote", tsv)

