== script f5_pointer_sweep.py
"""F5 round 8 / CORRECTION_LOG 141: pointers in the documents that name a file and say what it holds, and stray carriage returns.

A. a backticked path followed by lists / holds / has / contains / names / prints / states / defines / shows / records / keeps / says / documents,
   in the document lines added since e4bb4df: every hit is printed to be read against the named file.
B. a backticked docs path followed by a row id (E11, U4, X45 ...): the id has to occur in that file.
C. text files of the repository with a carriage return that is not followed by a line feed.
usage: python f5_pointer_sweep.py <repo-root>
"""
import pathlib
import re
import subprocess
import sys

root = pathlib.Path(sys.argv[1])


def git(*args):
    return subprocess.run(["git", *args], cwd=root, capture_output=True, text=True, encoding="utf-8", errors="replace").stdout


docs = [d for d in git("diff", "--name-only", "e4bb4df", "HEAD", "--", "docs", "opencode-memory.md", "CLAUDE.md").split("\n")
        if d.endswith(".md") and not d.startswith(("docs/artifacts/", "docs/stills/"))]

VERB = re.compile(r"`([A-Za-z0-9_./\-]+\.[A-Za-z0-9]{1,5}|tools/[A-Za-z0-9_./\-]+|scripts/[A-Za-z0-9_./\-]+)`\)?\s*(?:\(|:)?\s*(?:also\s)?"
                  r"(lists?|holds?|has|contains?|names?|prints?|states?|defines?|shows?|records?|keeps?|says?|documents?)\b")
print("== A: path + verb")
n = 0
for d in docs:
    for line in git("diff", "-U0", "e4bb4df", "HEAD", "--", d).splitlines():
        if not line.startswith("+") or line.startswith("+++"):
            continue
        for m in VERB.finditer(line):
            n += 1
            print("%s | %s" % (d.replace("docs/", ""), line[max(0, m.start() - 60):min(len(line), m.end() + 110)]))
print("hits", n)

print("== B: docs path + row id, the id has to occur in the file")
ROWID = re.compile(r"`((?:docs/)?[A-Za-z0-9_./\-]+\.md)`\s*(?:\(|,|:)?\s*(?:rows?\s+)?"
                   r"([A-Z]{1,4}[0-9]{1,3}(?:\.[0-9]+)?(?:-[A-Za-z0-9]+)?|U[0-9]|X[0-9]+)\b")
n = 0
missing = []
cache = {}
for d in docs:
    for line in git("diff", "-U0", "e4bb4df", "HEAD", "--", d).splitlines():
        if not line.startswith("+") or line.startswith("+++"):
            continue
        for m in ROWID.finditer(line):
            n += 1
            path, ident = m.group(1), m.group(2)
            if path not in cache:
                cache[path] = None
                for cand in (path, "docs/" + path):
                    if (root / cand).exists():
                        cache[path] = (root / cand).read_text(encoding="utf-8", errors="replace")
                        break
            text = cache[path]
            if text is None or not re.search(r"(?<![A-Za-z0-9])" + re.escape(ident) + r"(?![A-Za-z0-9])", text):
                missing.append("%s | %s %s" % (d, path, ident))
print("pointers checked", n, "id not in file", len(missing))
for x in missing:
    print(" ", x)

print("== C: a carriage return not followed by a line feed, in the tracked text files")
exts = (".md", ".py", ".sh", ".gd", ".json", ".txt", ".tsv", ".cfg", ".yml", ".yaml", ".tscn", ".tres")
files = [f for f in git("ls-files").split("\n") if f.endswith(exts) and not f.startswith(("docs/stills/", "addons/", ".claude/"))]
lone = []
for f in files:
    p = root / f
    if p.is_file() and re.search(rb"\r(?!\n)", p.read_bytes()):
        lone.append(f)
print("files scanned", len(files), "with a lone CR", len(lone))
for f in lone:
    print(" ", f)
