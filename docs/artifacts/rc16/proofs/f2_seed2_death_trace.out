== 4. what the bot prints: the revive line shows the DEATH counter, not a revive counter (scripts/tools/_qa_autoplay_runner.gd)
func _try_revive() -> void:
	if _act_cd > 0.0:
		return
	_act_cd = 2.0
	var gm := get_node_or_null("/root/GameManager")
	if gm != null and gm.has_method("revive_player"):
		gm.revive_player()
		_log("revived after death (%d total)" % _deaths)
