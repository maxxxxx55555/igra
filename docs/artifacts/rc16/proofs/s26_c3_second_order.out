"""Session 26 (C3): class-level members (var, const, signal, enum) of the scripts the sweep changed whose name now occurs once in the project text (the declaration)
or only inside the declaring file. A member that became unread because its reader was removed shows here. Read-only.
usage: python -I s26_second_order.py <repo> <changed-files.txt>"""
import collections
import pathlib
import re
import subprocess
import sys

print(pathlib.Path(__file__).read_text(encoding="utf-8"))
print("--- run")
root = pathlib.Path(sys.argv[1]).resolve()
changed = [l.strip() for l in pathlib.Path(sys.argv[2]).read_text(encoding="utf-8").split("\n") if l.strip()]
tracked = [t for t in subprocess.run(["git", "ls-files"], cwd=root, capture_output=True, text=True, encoding="utf-8").stdout.split("\n") if t]
TEXT = (".gd", ".tscn", ".tres", ".cfg", ".json", ".godot", ".gdshader")
corpus = {t: (root / t).read_text(encoding="utf-8", errors="replace") for t in tracked if t.endswith(TEXT) and not t.startswith(("docs/", "store/", "_QUARANTINE/"))}
word = collections.defaultdict(collections.Counter)
for f, text in corpus.items():
    for w in re.findall(r"[A-Za-z_][A-Za-z0-9_]*", text):
        word[w][f] += 1
DECL = re.compile(r"^(?:@[a-z_]+(?:\([^)]*\))?\s+)*(?:static\s+)?(var|const|signal|enum)\s+([A-Za-z_][A-Za-z0-9_]*)", re.M)
for f in changed:
    text = corpus.get(f)
    if text is None:
        continue
    for m in DECL.finditer(text):
        kind, name = m.group(1), m.group(2)
        total = sum(word[name].values())
        here = word[name].get(f, 0)
        others = total - here
        if others == 0 and here <= 1:
            print("%-48s %-6s %-26s declared, never read (%d occurrence)" % (f, kind, name, total))
        elif others == 0 and kind in ("const", "signal"):
            print("%-48s %-6s %-26s only inside its own file (%d occurrences)" % (f, kind, name, here))

