== script matrix_status.py
"""Count the rows of docs/FUNCTION_MATRIX.md by the first word of the Status cell (the last cell)."""
import collections
import pathlib
import re
import sys

text = (pathlib.Path(sys.argv[1]) / "docs" / "FUNCTION_MATRIX.md").read_text(encoding="utf-8")
counts = collections.Counter()
rows = 0
for line in text.splitlines():
    if not re.match(r"^\| [A-Z]+[0-9]+ \|", line):
        continue
    rows += 1
    cells = [c.strip() for c in re.split(r"(?<!\\)\|", line.strip().strip("|"))]
    first = re.sub(r"[^A-Z-].*$", "", cells[-1].replace("**", "").strip())
    counts[first] += 1
print("rows", rows, dict(counts))
