"""Session 20 (W2): size, colour type (alpha or not) and file size of every candidate store image of the repository. Read-only; prints itself first.
PNG colour type from the IHDR: 0 grey, 2 RGB, 3 palette, 4 grey + alpha, 6 RGBA. A palette PNG can carry transparency in a tRNS chunk."""
import pathlib
import struct
import sys

print(pathlib.Path(__file__).read_text(encoding="utf-8"))
print("--- run")
ROOT = pathlib.Path(sys.argv[1])
KIND = {0: "grey", 2: "RGB", 3: "palette", 4: "grey+alpha", 6: "RGBA"}
globs = ["assets/store/play_icon_512.png", "store/icon-512.png", "assets/store/v2/icon_512_v2.png",
         "store/feature-graphic.png", "assets/store/feature_graphic_1024x500.png", "assets/store/v2/feature_1024x500_v2.png",
         "assets/store/screenshot_0*.png", "store/screenshots/*.png", "store/screenshots/*.jpg", "docs/stills/release/*.png",
         "store/icon-adaptive/*.png"]
for pattern in globs:
    for p in sorted(ROOT.glob(pattern)):
        data = p.read_bytes()
        if data[:8] == b"\x89PNG\r\n\x1a\n":
            w, h = struct.unpack(">II", data[16:24])
            depth, ctype = data[24], data[25]
            trns = b"tRNS" in data[:4096]
            kind = "PNG %s/%d%s" % (KIND.get(ctype, ctype), depth, "+tRNS" if trns else "")
        else:
            kind, w, h = "other", 0, 0
        print("%-72s %5d x %-5d %-18s %9d bytes" % (p.relative_to(ROOT).as_posix(), w, h, kind, len(data)))

