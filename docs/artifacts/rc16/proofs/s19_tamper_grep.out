# proof s19_tamper_grep
# utc 20261011T083704Z
# head 14fc1b3 (uncommitted paths: 0)
# env none
# cmd bash C:/Users/Maxsim/AppData/Local/Temp/claude/C--Users-Maxsim-Desktop-TLS-Build-THE-LAST-STREETLIGHT/1b7febd1-9c60-4db2-8f84-207d10a1b816/scratchpad/s19_tamper.sh
#!/usr/bin/env bash
# Session 19 anti-tamper re-read at HEAD (no engine): every profile file the shipped scripts write and whether it goes through
# SaveSystem's signed envelope, the slot binding, the schema loaders, IntegrityGuard, the debug prints. Prints itself first.
cat "$0"
echo "--- run"
shipped=$(git ls-files 'scripts/*.gd' 'components/*.gd' 'addons/*.gd' | grep -v -E '^scripts/(tools|security)/|^scripts/stress_test.gd$')
echo "=== profile files named by the shipped scripts"
echo "$shipped" | xargs grep -n -o -E '"user://[A-Za-z0-9_./%-]+"' | sort -t: -k3 -u
echo "=== signed reads and writes (SaveSystem.read_signed / write_signed)"
echo "$shipped" | xargs grep -n -E 'SaveSystem\.(read_signed|write_signed)\(' | cut -c1-160
echo "=== the main save and its slots: the envelope and the slot id"
grep -n -E '^func (_write_atomic|_read_validated|save_slot|load_slot)|slot_id' scripts/core/save_system.gd | cut -c1-160
echo "=== IntegrityGuard and PlayIntegrityService autoloads"
grep -n -E '^(IntegrityGuard|PlayIntegrityService)=' project.godot
echo "=== print( in the shipped scripts (a line that starts with a print call)"
echo "$shipped" | xargs grep -n -E '^\s*(print|prints|printt|print_debug|printerr)\(' | cut -c1-160
echo "=== the export filters of the Android preset (the Session 19 additions)"
sed -n 3p export_presets.cfg | tr ',' '\n' | grep -n -E 'opencode|missing_keys|tests|stress_test|test_zone|store/'
