"""Session 24 (C1): the planned-feature cross-check of the directive. For each candidate (file name and, for scripts, the stem), the lines
of the canon and planning documents that name it: VISUAL_PASS, STORE_KIT, CARD_ART_BRIEF, MUSIC_BRIEF, MUSIC_SPEC, GDD (all GDD*.md),
GAMEFEEL_SPEC, PRODUCTION_BIBLE and PLAN.md. A candidate named there as something to build or keep is KEEP-PLANNED; a candidate named as
dead, archived or superseded, or only listed, is not. Prints the lines for reading. Prints itself first.
usage: python -I s24_planned_xcheck.py <repo> <list-file>"""
import pathlib
import re
import sys

print(pathlib.Path(__file__).read_text(encoding="utf-8"))
print("--- run")
ROOT = pathlib.Path(sys.argv[1]).resolve()
cands = [ln.strip() for ln in pathlib.Path(sys.argv[2]).read_text(encoding="utf-8").splitlines() if ln.strip()]
docs = ["docs/VISUAL_PASS.md", "docs/STORE_KIT.md", "docs/CARD_ART_BRIEF.md", "docs/MUSIC_BRIEF.md", "docs/MUSIC_SPEC.md", "docs/GAMEFEEL_SPEC.md",
        "docs/PRODUCTION_BIBLE.md", "PLAN.md"] + sorted(str(p.relative_to(ROOT)).replace("\\", "/") for p in (ROOT / "docs").glob("GDD*.md"))
text = {d: (ROOT / d).read_text(encoding="utf-8", errors="replace").splitlines() for d in docs if (ROOT / d).is_file()}
print("canon documents read: %d" % len(text))
flagged = 0
for c in cands:
    name = pathlib.PurePosixPath(c).name
    stem = name.rsplit(".", 1)[0]
    needles = {name}
    needles.add(stem)  # the stem of an asset too: a plan names "ambient_dark_loop", not the .wav
    rows = []
    for d, lines in text.items():
        for n, ln in enumerate(lines, 1):
            if any(re.search(r"(?<![A-Za-z0-9_])" + re.escape(k) + r"(?![A-Za-z0-9_])", ln) for k in needles):
                rows.append((d, n, ln.strip()[:170]))
    if rows:
        flagged += 1
        print("NAMED %s" % c)
        for d, n, ln in rows[:5]:
            print("      %s:%d %s" % (d, n, ln))
    else:
        print("clear %s" % c)
print("named in a canon or planning document: %d of %d" % (flagged, len(cands)))

