# cmd python -I C:/Users/Maxsim/AppData/Local/Temp/claude/C--Users-Maxsim-Desktop-TLS-Build-THE-LAST-STREETLIGHT/1b7febd1-9c60-4db2-8f84-207d10a1b816/scratchpad/s20_ctrl_scan.py .
"""Session 20: control characters (C0 except tab, CR, LF; DEL; C1) in every text file this pass changed or added: the trap of a backslash and
digits read as an octal escape through a Bash heredoc (CORRECTION_LOG 185). The escape character (27) is allowed in the raw logs of
docs/artifacts/rc16/proofs/, whose colour codes are what the log is. Prints itself first. usage: python -I s20_ctrl_scan.py <repo>"""
import pathlib
import re
import subprocess
import sys

print(pathlib.Path(__file__).read_text(encoding="utf-8"))
print("--- run")
root = pathlib.Path(sys.argv[1]).resolve()
ESC = chr(27)


def git(*a):
    return subprocess.run(["git", *a], cwd=root, capture_output=True, text=True, encoding="utf-8").stdout.split("\n")


paths = sorted({p for p in git("diff", "--name-only", "v8.0.0-final") + git("diff", "--name-only") + git("ls-files", "-o", "--exclude-standard") if p})
bad = re.compile("[\x00-\x08\x0b\x0c\x0e-\x1f\x7f-\x9f]")
checked = hits = 0
for rel in paths:
    p = root / rel
    if not p.is_file() or p.suffix in (".png", ".jpg", ".import", ".uid"):
        continue
    data = p.read_bytes()
    if b"\x00" in data[:8192]:
        continue
    checked += 1
    text = data.decode("utf-8", errors="replace")
    for m in bad.finditer(text):
        if m.group(0) == ESC and rel.startswith("docs/artifacts/rc16/proofs/"):
            continue
        hits += 1
        print("  %s offset %d U+%04X" % (rel, m.start(), ord(m.group(0))))
print("text files checked: %d, control characters: %d" % (checked, hits))
sys.exit(1 if hits else 0)

