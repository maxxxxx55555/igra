== script af5_overlap.py
"""Citation overlap: for each citation of the AF5 scope, do the numbers and the longer words of the 140 characters before it occur in the cited lines?
A citation whose sentence shares no number and no word of 5 or more letters with the cited lines is listed with both texts, to be read by hand.
usage: af5_overlap.py <repo-root>"""
import importlib.util
import pathlib
import re
import sys

root = pathlib.Path(sys.argv[1])
spec = importlib.util.spec_from_file_location("af5", root / "tools" / "af5_check.py")
af5 = importlib.util.module_from_spec(spec)
spec.loader.exec_module(af5)

NUMBER = re.compile(r"(?<![\w.])\d+(?:\.\d+)?(?![\w.])")
WORD = re.compile(r"[A-Za-z_][A-Za-z0-9_]{4,}")
STOP = {"which", "their", "there", "these", "those", "about", "after", "before", "where", "while", "being", "other", "every", "under", "above", "should",
        "would", "could", "stays", "stay", "holds", "hold", "shown", "shows", "found", "same", "with", "that", "this", "from", "into", "than", "then", "when",
        "only", "docs", "scripts", "tools", "scenes", "assets", "gdscript"}

rows, total = [], 0
for doc, number, text in af5.added_lines("e4bb4df"):
    for m in af5.CITE.finditer(text):
        path = af5.resolve(m.group("path"))
        if path is None:
            continue
        total += 1
        src = (root / path).read_text(encoding="utf-8", errors="replace").replace("\r\n", "\n").split("\n")
        cited = []
        for part in m.group("spec").split(","):
            a, b = (int(x) for x in (part.split("-") * 2)[:2])
            cited += src[a - 1:b]
        cited_text = " ".join(cited).lower()
        before = text[max(0, m.start() - 140):m.start()]
        before = af5.CITE.sub(" ", before)
        tokens = [n for n in NUMBER.findall(before) if len(n) >= 2] + [w for w in WORD.findall(before) if w.lower() not in STOP]
        if not tokens:
            continue
        if not any(t.lower() in cited_text for t in tokens):
            rows.append((doc, number, m.group(0), before.strip().replace("\n", " ")[-110:], " / ".join(s.strip() for s in cited)[:100]))

for doc, number, cite, before, cited in rows:
    print("%s:%d | %s | BEFORE: ...%s | CITED: %s" % (doc, number, cite, before, cited))
print("citations: %d, without any shared number or word: %d" % (total, len(rows)))
