"""Session 19 bundle check that release_export_check.py does not make: the imported textures of the store art. Godot packs an image as
.godot/imported/<name>-<md5>.ctex next to its <name>.import, so a filter that drops the .import must drop the .ctex too. Lists, for each
tracked image under store/ (store/icon-adaptive/ is the launcher icon and stays), the bundle entries of its imported copy. Prints itself first."""
import pathlib
import subprocess
import sys
import zipfile

ROOT = pathlib.Path(r"C:\Users\Maxsim\Desktop\TLS_Build\THE_LAST_STREETLIGHT")
print(pathlib.Path(__file__).read_text(encoding="utf-8"))
print("--- run")
tracked = subprocess.run(["git", "ls-files", "store"], cwd=ROOT, capture_output=True, text=True, check=True).stdout.split()
art = [p for p in tracked if p.lower().endswith((".png", ".jpg", ".webp")) and not p.startswith("store/icon-adaptive/")]
aab = pathlib.Path(sys.argv[1])
with zipfile.ZipFile(aab) as z:
    infos = z.infolist()
found, size = 0, 0
for p in art:
    name = p.rsplit("/", 1)[1]
    hits = [i for i in infos if "/.godot/imported/" + name + "-" in i.filename or i.filename.endswith("/" + p + ".import")]
    found += len(hits)
    size += sum(i.compress_size for i in hits)
    print("%-70s %d entries %d bytes compressed" % (p, len(hits), sum(i.compress_size for i in hits)))
print("%s: %d bytes, %d store images tracked, %d bundle entries of them, %d bytes compressed" % (aab.name, aab.stat().st_size, len(art), found, size))
sys.exit(1 if found else 0)

