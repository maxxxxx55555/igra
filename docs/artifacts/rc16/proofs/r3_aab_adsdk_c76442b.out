"""Ad SDK scan of an AAB: entries named applovin and dex references to com/applovin classes. Prints itself first."""
import pathlib
import sys
import zipfile

print(pathlib.Path(__file__).read_text(encoding="utf-8"))
print("--- run")
with zipfile.ZipFile(sys.argv[1]) as z:
    named = [i.filename for i in z.infolist() if "applovin" in i.filename.lower()]
    refs = sum(z.read(i).count(b"Lcom/applovin/") for i in z.infolist() if i.filename.endswith(".dex"))
    dex = sum(1 for i in z.infolist() if i.filename.endswith(".dex"))
print("entries named applovin:", len(named))
for n in named:
    print("  " + n)
print("dex files:", dex, "references to Lcom/applovin/:", refs)

