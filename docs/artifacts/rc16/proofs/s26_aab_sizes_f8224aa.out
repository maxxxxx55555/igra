import zipfile, collections
z = zipfile.ZipFile('build/tls.aab')
c = collections.Counter()
n = collections.Counter()
for i in z.infolist():
    k = i.filename.split('/')[0]
    c[k] += i.compress_size
    n[k] += 1
print(len(z.infolist()), 'entries')
[print(k, n[k], 'entries', c[k], 'compressed bytes') for k in sorted(c)]

