# proof aab_verify_rc16
# utc 20261010T202805Z
# head 5bacfbe (uncommitted paths: 3)
# env none
# cmd bash /c/Users/Maxsim/AppData/Local/Temp/claude/C--Users-Maxsim-Desktop-TLS-Build-THE-LAST-STREETLIGHT/1b7febd1-9c60-4db2-8f84-207d10a1b816/scratchpad/aab_verify.sh
#!/usr/bin/env bash
# Verify the rc16 AAB: size, sha256, signature, signer certificate, module sizes, excluded paths, bus layout entry. Prints itself first.
cat "$0"
echo "--- run"
aab=build/tls.aab
echo "bytes=$(stat -c %s "$aab") mtime=$(date -u -r "$aab" +%Y%m%dT%H%M%SZ)"
sha256sum "$aab"
echo "--- jarsigner -verify"
jarsigner -verify "$aab"; echo "jarsigner exit=$?"
echo "--- keytool -printcert -jarfile"
keytool -printcert -jarfile "$aab" | grep -E 'Owner|Issuer|SHA256'; echo "keytool exit=${PIPESTATUS[0]}"
echo "--- documented upload key (docs/RELEASE_ARTIFACTS.md)"
want=$(grep -o -E 'SHA-256 `[0-9A-F:]{95}`' docs/RELEASE_ARTIFACTS.md | head -1 | grep -o -E '[0-9A-F:]{95}')
got=$(keytool -printcert -jarfile "$aab" | grep -o -E 'SHA256: [0-9A-F:]{95}' | head -1 | cut -c9-)
echo "documented=$want"
echo "in_bundle=$got"
[[ -n "$want" && "$want" == "$got" ]] && echo "signer_match=yes" || echo "signer_match=no"
echo "--- modules (zip entries, compressed and raw bytes), excluded paths, bus layout"
python -I - "$aab" <<'PY'
import sys
import zipfile
mods = {}
with zipfile.ZipFile(sys.argv[1]) as z:
    infos = z.infolist()
    for i in infos:
        m = i.filename.split("/", 1)[0]
        c, r, n = mods.get(m, (0, 0, 0))
        mods[m] = (c + i.compress_size, r + i.file_size, n + 1)
    print("entries", len(infos))
    for m, (c, r, n) in sorted(mods.items()):
        print(f"{m} entries={n} compressed={c} raw={r}")
    for k in ("assets/docs/", "assets/tools/", "assets/scenes/tools/", "assets/scripts/tools/"):
        print(f"entries under {k}: {sum(k in i.filename for i in infos)}")
    for i in infos:
        if "default_bus_layout" in i.filename:
            d = z.read(i)
            print(f"bus layout entry {i.filename} bytes={i.file_size} room_size={b'room_size' in d} Master={b'Master' in d}")
PY
