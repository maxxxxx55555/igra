# proof s20_secret_scan
# utc 20261011T182341Z
# head 6f6d643 (uncommitted paths: 12)
# env none
# cmd python -I /c/Users/Maxsim/AppData/Local/Temp/claude/C--Users-Maxsim-Desktop-TLS-Build-THE-LAST-STREETLIGHT/1b7febd1-9c60-4db2-8f84-207d10a1b816/scratchpad/s20_secret_scan.py .
"""Session 20 (W3): keys and tokens in the tracked files at HEAD and in the whole history of the repository.
A value is never printed: a hit is shown as path:line, the pattern, the length and the first 3 characters. Prints itself first.
usage: python -I s20_secret_scan.py <repo>      exit 1 when a hit is outside the declared list (KNOWN)."""
import json
import pathlib
import re
import subprocess
import sys

print(pathlib.Path(__file__).read_text(encoding="utf-8"))
print("--- run")
ROOT = pathlib.Path(sys.argv[1]).resolve()
PATTERNS = {
    "sk_key": r"\bsk-[A-Za-z0-9_\-]{20,}",
    "aws_access_key": r"\bAKIA[0-9A-Z]{16}\b",
    "google_api_key": r"\bAIza[0-9A-Za-z_\-]{35}\b",
    "github_token": r"\bgh[pousr]_[A-Za-z0-9]{36,}|\bgithub_pat_[A-Za-z0-9_]{40,}",
    "slack_token": r"\bxox[abprs]-[A-Za-z0-9\-]{10,}",
    "private_key_block": r"-----BEGIN [A-Z ]*PRIVATE KEY-----",
    "jwt": r"\beyJ[A-Za-z0-9_\-]{10,}\.[A-Za-z0-9_\-]{10,}\.[A-Za-z0-9_\-]{10,}",
    "assigned_secret": r"(?i)\b(?:password|passwd|secret|api[_-]?key|access[_-]?token|auth[_-]?token)[\"']?\s*[:=]\s*[\"']([A-Za-z0-9_\-/+=.]{16,})[\"']",
}
COMPILED = {k: re.compile(v) for k, v in PATTERNS.items()}
# a hit in these paths is the known one: the key of the local router (CORRECTION_LOG 167), to be rotated by the owner
KNOWN = {"opencode.json"}


def git(*args):
    r = subprocess.run(["git", *args], cwd=ROOT, capture_output=True, text=True, encoding="utf-8", errors="replace")
    return r.stdout


def mask(value):
    return "len=%d prefix=%s" % (len(value), value[:3])


files = [f for f in git("ls-files").split("\n") if f]
print("tracked files: %d" % len(files))
hits, skipped = [], 0
for rel in files:
    p = ROOT / rel
    try:
        if not p.is_file() or p.stat().st_size > 6_000_000:
            skipped += 1
            continue
        data = p.read_bytes()
    except OSError:
        skipped += 1
        continue
    if b"\x00" in data[:8192]:
        skipped += 1
        continue
    text = data.decode("utf-8", errors="replace")
    for number, line in enumerate(text.split("\n"), 1):
        for name, rx in COMPILED.items():
            m = rx.search(line)
            if m:
                value = m.group(1) if m.groups() else m.group(0)
                hits.append((rel, number, name, mask(value)))
print("skipped (binary, over 6 MB or unreadable): %d" % skipped)
unknown = [h for h in hits if h[0] not in KNOWN]
print("hits in tracked files: %d (%d in the declared list %s, %d outside it)" % (len(hits), len(hits) - len(unknown), sorted(KNOWN), len(unknown)))
for rel, number, name, masked in unknown[:60]:
    print("  OUTSIDE %s:%d %s %s" % (rel, number, name, masked))
for rel, number, name, masked in [h for h in hits if h[0] in KNOWN]:
    print("  KNOWN   %s:%d %s %s" % (rel, number, name, masked))

print("--- history (every ref; pickaxe on added or removed lines)")
for name in ("sk_key", "aws_access_key", "google_api_key", "github_token", "slack_token", "private_key_block", "jwt"):
    commits = git("log", "--all", "-G" + PATTERNS[name], "--format=%h").split()
    print("history %-18s commits=%d %s" % (name, len(commits), " ".join(commits[:12])))
key = ""
oc = ROOT / "opencode.json"
if oc.is_file():
    m = re.search(r"\bsk-[A-Za-z0-9_\-]{20,}", oc.read_text(encoding="utf-8", errors="replace"))
    key = m.group(0) if m else ""
if key:
    commits = git("log", "--all", "-S" + key, "--format=%h").split()
    paths = [f for f in files if (ROOT / f).is_file() and (ROOT / f).stat().st_size < 6_000_000 and key.encode() in (ROOT / f).read_bytes()]
    print("the opencode.json key (%s): commits that add or remove it: %d %s; tracked files that hold it: %s" % (mask(key), len(commits), " ".join(commits[:12]), paths))
sensitive = git("log", "--all", "--diff-filter=A", "--format=%h", "--name-only", "--", ".signing", "*.keystore", "*.jks", "*.p12", "*.pem", "release.env", ".env", "google-services.json").split()
print("sensitive file names ever added to history: %s" % (sensitive or "none"))
print("tracked under .signing/: %d" % len([f for f in files if f.startswith(".signing/")]))
ignored = git("check-ignore", "-v", ".signing/release.env").strip()
print("check-ignore .signing/release.env: %s" % (ignored or "NOT IGNORED"))
untracked = [l[3:] for l in git("status", "--porcelain", "--untracked-files=all").split("\n") if l.startswith("??")]
risky = [u for u in untracked if re.search(r"(?i)(secret|\.env|\.pem|\.key|\.jks|keystore|token|credential)", u)]
print("untracked and not ignored: %d, of them with a secret-like name: %s" % (len(untracked), risky or "none"))
print("secret findings outside the declared list: %d" % len(unknown))
sys.exit(1 if unknown or risky or sensitive else 0)

