"""Session 25 (G2 step 1): the 19 achievements of the only expansion proposal in the repository (docs/jules/ACHIEVEMENT_TRIGGER_SPEC.md on
origin/jules/parallel-audit-1403790779115270347, the stand-in for the missing docs/gemini/ACHIEVEMENT_50_SPEC.md), each row checked at HEAD: is the cited signal
declared in scripts/events/event_bus.gd, is it emitted anywhere in scripts/ (outside tools), does the cited file exist and have the cited line, and what that
line holds. Read-only. Prints itself first.
usage: python -I s25_ach_hooks.py <repo> <jules-ref>"""
import pathlib
import re
import subprocess
import sys

print(pathlib.Path(__file__).read_text(encoding="utf-8"))
print("--- run")
repo = pathlib.Path(sys.argv[1]).resolve()
ref = sys.argv[2]
spec = subprocess.run(["git", "show", ref + ":docs/jules/ACHIEVEMENT_TRIGGER_SPEC.md"], cwd=repo, capture_output=True, text=True, encoding="utf-8").stdout
rows = re.findall(r"^\| `(ach_\d+)` \| `[A-Z_0-9]+` \| `[A-Z_0-9]+` \| `EventBus\.(\w+)` \| `([^`:]+):(\d+)` \| ([^|]+)\|", spec, re.M)
bus = (repo / "scripts/events/event_bus.gd").read_text(encoding="utf-8")
declared = set(re.findall(r"^signal (\w+)", bus, re.M))
emitters = {}
for f in (repo / "scripts").rglob("*.gd"):
    if "/tools/" in f.as_posix():
        continue
    for m in re.finditer(r"EventBus\.(\w+)\.emit\(", f.read_text(encoding="utf-8", errors="replace")):
        emitters.setdefault(m.group(1), set()).add(f.relative_to(repo).as_posix())
print("proposals read: %d; signals declared in event_bus.gd: %d" % (len(rows), len(declared)))
ok = 0
for aid, sig, path, line, cond in rows:
    f = repo / path
    text = ""
    if f.is_file():
        lines = f.read_text(encoding="utf-8", errors="replace").splitlines()
        text = lines[int(line) - 1].strip()[:70] if int(line) <= len(lines) else "(line beyond the file)"
    else:
        text = "(file absent)"
    decl = sig in declared
    em = sorted(emitters.get(sig, ()))
    ok += decl and bool(em)
    print("%s %-26s declared=%-5s emitted_in=%-2d %-40s cited %s:%s -> %s | %s" % (aid, sig, decl, len(em), (em[0] if em else "-"), path, line, text, cond.strip()))
print("rows whose signal is declared and emitted at HEAD: %d of %d" % (ok, len(rows)))

