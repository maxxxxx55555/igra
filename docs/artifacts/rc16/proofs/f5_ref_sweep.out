== script ref_sweep.py
"""Stale references in the documents changed since e4bb4df: backticked commit hashes that are no commit, backticked repository paths that do not exist,
backticked proof ids that have no file in docs/artifacts/rc16/proofs. Only the lines added since e4bb4df are read.
usage: ref_sweep.py <repo-root>"""
import pathlib
import re
import subprocess
import sys

root = pathlib.Path(sys.argv[1])


def git(*args):
    r = subprocess.run(["git", *args], cwd=root, capture_output=True, text=True, encoding="utf-8", errors="replace")
    return r.stdout


docs = [d for d in git("diff", "--name-only", "e4bb4df", "HEAD", "--", "docs", "opencode-memory.md", ".claude/skills/THIRD_PARTY.md").split("\n")
        if d.endswith(".md") and not d.startswith(("docs/artifacts/", "docs/stills/"))]
proofs = {p.name.split(".")[0] for p in (root / "docs" / "artifacts" / "rc16" / "proofs").iterdir()}
HASH = re.compile(r"`([0-9a-f]{7,12})`")
PATH = re.compile(r"`((?:res://)?[A-Za-z0-9_.\-]+(?:/[A-Za-z0-9_.\-{},*<>]+)+\.[A-Za-z0-9]{1,8})(?::\d+(?:-\d+)?(?:,\d+(?:-\d+)?)*)?`")
PROOF = re.compile(r"`((?:s\d|f\d|l\d|af|accept|final|i18n|lint|bot|timing|probe|frame|perf|sec|utilities|gapowner|ci_|s0_|s1_|s2_|s3|s4|s6|s7|s8|s9)[a-z0-9_]*)`")

seen = set()
bad = []
for doc in docs:
    patch = git("diff", "-U0", "e4bb4df", "HEAD", "--", doc)
    for line in patch.splitlines():
        if not line.startswith("+") or line.startswith("+++"):
            continue
        text = line[1:]
        for h in HASH.findall(text):
            if ("hash", h) in seen:
                continue
            seen.add(("hash", h))
            if subprocess.run(["git", "cat-file", "-e", h + "^{commit}"], cwd=root, capture_output=True).returncode != 0 and \
               subprocess.run(["git", "cat-file", "-e", h], cwd=root, capture_output=True).returncode != 0:
                bad.append((doc, "hash", h, text[:100]))
        for p in PATH.findall(text):
            key = ("path", p)
            if key in seen or any(c in p for c in "*<>{},") or p.startswith(("user://", "http")):
                continue
            seen.add(key)
            q = p.replace("res://", "")
            if not any((root / base / q).exists() for base in ("", "docs", "docs/artifacts/rc16/proofs", "docs/artifacts/rc16", "scripts", "tools")):
                bad.append((doc, "path", p, text[:100]))
        for p in PROOF.findall(text):
            key = ("proof", p)
            if key in seen:
                continue
            seen.add(key)
            if p not in proofs and not (root / "docs" / "artifacts" / "rc16" / (p + ".txt")).exists():
                bad.append((doc, "proof", p, text[:100]))

for doc, kind, ref, ctx in bad:
    print("%s | %s | %s | %s" % (doc, kind, ref, ctx.replace("\n", " ")))
print("documents: %d, distinct references checked: %d, not found: %d" % (len(docs), len(seen), len(bad)))
