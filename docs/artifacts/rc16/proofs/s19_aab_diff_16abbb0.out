"""Session 19, P5: what the rebuilt bundle changes against the v8.0.0 bundle (63fda65, kept in _BACKUPS). Arguments: old.aab new.aab.
Lists the entries only in the old one, only in the new one, and those with the same name and other bytes (size or CRC); then counts the
removed ones by what they are. Every removed entry must be a file that is not the game (test, store art or its import, the key file, the
dead test scene, the stress script) and nothing may be added. Prints itself first."""
import collections
import pathlib
import re
import sys
import zipfile

print(pathlib.Path(__file__).read_text(encoding="utf-8"))
print("--- run")


def entries(path):
    with zipfile.ZipFile(path) as z:
        return {i.filename: (i.file_size, i.CRC) for i in z.infolist()}


def short(name):
    return re.sub(r"^assetPackInstallTime/assets/", "", name)


def kind(name):
    s = short(name)
    if s.startswith(".godot/imported/") and re.search(r"-[0-9a-f]{32}\.ctex$", s):
        return "imported texture of a store image"
    if s.startswith(".godot/exported/") and "test_zone" in s:
        return "exported test scene"
    if s.startswith("store/"):
        return "store file (image import or shot list)"
    if s.startswith("tests/"):
        return "tests/"
    if s in ("opencode.json", "missing_keys.json"):
        return "tool file in the project root"
    if s.startswith("scripts/stress_test.gd") or s.startswith("scenes/world/test_zone"):
        return "stress script or test scene"
    return "OTHER"


old, new = entries(sys.argv[1]), entries(sys.argv[2])
removed = sorted(set(old) - set(new))
added = sorted(set(new) - set(old))
changed = sorted(n for n in set(old) & set(new) if old[n] != new[n])
print("old %s: %d entries; new %s: %d entries" % (pathlib.Path(sys.argv[1]).name, len(old), pathlib.Path(sys.argv[2]).name, len(new)))
print("removed %d, added %d, same name with other bytes %d" % (len(removed), len(added), len(changed)))
by = collections.Counter(kind(n) for n in removed)
for k, v in sorted(by.items()):
    print("  removed %-40s %d" % (k, v))
for n in removed:
    if kind(n) == "OTHER":
        print("  OTHER removed: " + short(n))
for n in added:
    print("  ADDED: " + short(n))
for n in changed:
    print("  changed: %-72s %d -> %d bytes" % (short(n)[:72], old[n][0], new[n][0]))
bad = by.get("OTHER", 0) + len(added)
print("bundle diff: removed=%d (all not the game: %s) added=%d changed=%d" % (len(removed), "yes" if not by.get("OTHER") else "NO", len(added), len(changed)))
sys.exit(1 if bad else 0)

