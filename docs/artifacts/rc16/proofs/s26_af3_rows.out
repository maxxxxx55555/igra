"""Session 26: the runtime paths that differ between the commit of the release frames (`ccc7669`) and HEAD, each with its git blob before and after and the scope row of
tools/qa_sim/af3_f4_scope.tsv that declares it (or none), then the frame gate itself. Read-only; prints itself first. usage: python -I s26_af3_rows.py <repo> [<frame commit>]"""
import pathlib
import subprocess
import sys

print(pathlib.Path(__file__).read_text(encoding="utf-8"))
print("--- run")
root = pathlib.Path(sys.argv[1]).resolve()
frame = sys.argv[2] if len(sys.argv) > 2 else "ccc7669"
sys.path.insert(0, str(root / "tools" / "qa_sim"))
import af3_frame_check as gate  # noqa: E402

head = subprocess.run(["git", "rev-parse", "--short", "HEAD"], cwd=root, capture_output=True, text=True).stdout.strip()
scoped = gate.scopes()
paths = [p for p in gate.changed_paths(frame, "HEAD") if gate.is_runtime(p)]
print("runtime paths that differ between %s and %s: %d" % (frame, head, len(paths)))
for p in paths:
    before, after = gate.blob(frame, p), gate.blob("HEAD", p)
    rows = [g for (path, a, b), g in scoped.items() if path == p and before.startswith(a[:12]) and after.startswith(b[:12])]
    print("  %-48s %s -> %s  scope row: %s" % (p, before[:12], after[:12], rows[0] if rows else "NONE"))
sys.stdout.flush()
sys.exit(subprocess.run([sys.executable, str(root / "tools" / "qa_sim" / "af3_frame_check.py")], cwd=root).returncode)

