"""Session 26 (export 2): the compiled daily manager in each bundle given (size, CRC), and the entries that differ between the first and the last bundle with their sizes. The .gdc is zstd-packed
binary tokens, so its identifiers cannot be read here; what this proof shows is which entries changed and by how many bytes. Read-only; prints itself first.
usage: python -I s26_aab_daily.py <first.aab> <last.aab>"""
import pathlib
import sys
import zipfile

print(pathlib.Path(__file__).read_text(encoding="utf-8"))
print("--- run")
ENTRY = "assetPackInstallTime/assets/scripts/systems/daily_challenge_manager.gdc"
first, last = (zipfile.ZipFile(p) for p in sys.argv[1:3])
for name, z in (("first", first), ("last", last)):
    i = z.getinfo(ENTRY)
    print("%-5s bundle %s: %s %d bytes, CRC %08x" % (name, pathlib.Path(sys.argv[1 if name == 'first' else 2]).name, ENTRY.rsplit("/", 1)[-1], i.file_size, i.CRC))
a = {i.filename: i for i in first.infolist()}
b = {i.filename: i for i in last.infolist()}
print("entries only in the first bundle: %d; only in the last: %d" % (len(set(a) - set(b)), len(set(b) - set(a))))
for n in sorted(a):
    if n in b and (a[n].CRC != b[n].CRC or a[n].file_size != b[n].file_size):
        print("  changed %-76s %d -> %d bytes" % (n, a[n].file_size, b[n].file_size))

