"""Session 24 (C1): the two last checks before the three asset folders go. 1 the uid of each .import sidecar appears in no other tracked text
file; 2 the live replacement the documents name exists on disk and is read by code: the .ogg of each wav_src file, icons_v2/ach_medal_v2_*
for the legacy achievement icons, renders_v2/weapons/*_render_256.png for the weapon icons. Prints itself first.
usage: python -I s24_uid_replace_check.py <repo> <list-file>"""
import pathlib
import re
import subprocess
import sys

print(pathlib.Path(__file__).read_text(encoding="utf-8"))
print("--- run")
ROOT = pathlib.Path(sys.argv[1]).resolve()
cands = [ln.strip() for ln in pathlib.Path(sys.argv[2]).read_text(encoding="utf-8").splitlines() if ln.strip() and not ln.startswith("_QUARANTINE")]
files = [f for f in subprocess.run(["git", "ls-files"], cwd=ROOT, capture_output=True, text=True, encoding="utf-8").stdout.split("\n") if f]
TEXT = (".gd", ".tscn", ".tres", ".cfg", ".godot", ".json", ".import", ".md", ".py", ".txt", ".uid", ".gdshader")
corpus = {}
for f in files:
    if f.endswith(TEXT) and not f.startswith(("docs/artifacts/", "docs/stills/")):
        p = ROOT / f
        if p.is_file() and p.stat().st_size < 3_000_000:
            corpus[f] = p.read_text(encoding="utf-8", errors="replace")
bad = 0
for c in cands:
    side = c + ".import"
    uid = ""
    if (ROOT / side).is_file():
        m = re.search(r'uid="(uid://[a-z0-9]+)"', (ROOT / side).read_text(encoding="utf-8", errors="replace"))
        uid = m.group(1) if m else ""
    users = [f for f, t in corpus.items() if uid and uid in t and f != side]
    flag = "ok" if not users else "USED"
    bad += bool(users)
    print("%-4s %-70s uid=%s users=%s" % (flag, c, uid or "-", users[:3] or "none"))
print("sidecar uid used elsewhere: %d" % bad)
print("--- replacements on disk")
for c in cands:
    p = pathlib.PurePosixPath(c)
    if c.startswith("assets/audio/ambience/wav_src/"):
        rep = "assets/audio/ambience/%s.ogg" % p.stem
    elif p.name.startswith("ach_"):
        rep = None
    else:
        rep = None
    if rep:
        print("%s -> %s %s" % (c, rep, "present" if (ROOT / rep).is_file() else "ABSENT"))
v2 = sorted(f for f in files if f.startswith("assets/textures/icons_v2/ach_medal_v2_"))
print("icons_v2/ach_medal_v2_*: %d files, first %s" % (len(v2), v2[:1]))
w = sorted(f for f in files if f.startswith("assets/textures/renders_v2/weapons/") and f.endswith("_render_256.png"))
print("renders_v2/weapons/*_render_256.png: %d files %s" % (len(w), [pathlib.PurePosixPath(x).name for x in w]))
ach = [f for f, t in corpus.items() if f.endswith(".gd") and "ach_medal_v2" in t]
print("code that reads ach_medal_v2: %s" % ach[:3])
wp = [f for f, t in corpus.items() if f.endswith(".gd") and "_render_256" in t]
print("code that reads *_render_256: %s" % wp[:3])

