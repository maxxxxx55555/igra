"""Session 26 (C3): functions of the shipped GDScript (scripts/, not scripts/tools) whose name occurs nowhere else in the project: not in any .gd, .tscn, .tres, .cfg,
.json or .godot file (a call, a connect, a Callable string, a has_method string, a method track and a signal connection of a scene all name the function). The
engine's virtual methods and the names the engine calls by convention are excluded. A candidate is only a candidate: each is read by hand. Read-only.
Prints itself first. usage: python -I s26_dead_funcs.py <repo>"""
import collections
import pathlib
import re
import subprocess
import sys

print(pathlib.Path(__file__).read_text(encoding="utf-8"))
print("--- run")
root = pathlib.Path(sys.argv[1]).resolve()
tracked = [t for t in subprocess.run(["git", "ls-files"], cwd=root, capture_output=True, text=True, encoding="utf-8").stdout.split("\n") if t]
TEXT = (".gd", ".tscn", ".tres", ".cfg", ".json", ".godot", ".gdshader")
corpus = {t: (root / t).read_text(encoding="utf-8", errors="replace") for t in tracked if t.endswith(TEXT) and not t.startswith(("docs/", "store/"))}
VIRTUAL = {"_ready", "_process", "_physics_process", "_input", "_unhandled_input", "_unhandled_key_input", "_shortcut_input", "_gui_input", "_notification", "_draw",
           "_enter_tree", "_exit_tree", "_init", "_to_string", "_get_configuration_warnings", "_get", "_set", "_get_property_list", "_validate_property", "_property_can_revert",
           "_property_get_revert", "_integrate_forces", "_can_drop_data", "_drop_data", "_get_drag_data", "_make_custom_tooltip", "_get_minimum_size", "_has_point",
           "_get_tooltip", "_clips_input", "_structured_text_parser", "_get_allowed_size_flags_horizontal", "_get_allowed_size_flags_vertical", "_parse_property",
           "_import", "_run", "_build", "_save_state", "_load_state", "_process_state", "_instantiate", "_create_audio_stream", "_get_length", "_get_beat_count"}
DEF = re.compile(r"^[ \t]*(?:static[ \t]+)?func[ \t]+([A-Za-z_][A-Za-z0-9_]*)[ \t]*\(", re.M)
word = {}
for f, text in corpus.items():
    for w in re.findall(r"[A-Za-z_][A-Za-z0-9_]*", text):
        word.setdefault(w, collections.Counter())[f] += 1
defs = collections.Counter(d for text in corpus.values() for d in DEF.findall(text))
cands = []
total = 0
for f, text in corpus.items():
    if not f.endswith(".gd") or not f.startswith("scripts/") or f.startswith("scripts/tools/"):
        continue
    for m in DEF.finditer(text):
        name = m.group(1)
        total += 1
        if name in VIRTUAL:
            continue
        occ = sum(word.get(name, {}).values())
        if occ - defs[name] <= 0:
            line = text.count("\n", 0, m.start(1)) + 1
            cands.append((f, line, name))
print("functions defined in shipped scripts: %d; candidates with no other occurrence: %d" % (total, len(cands)))
for f, line, name in sorted(set(cands)):
    print("%s:%d %s" % (f, line, name))

