"""Session 26 (C3): of the dead-function candidates (s26_dead_funcs.py output) keep those that no document (outside the logs of what was done) and no tool names.
usage: python -I s26_dead_filter.py <repo> <candidates-out.txt> <zero.txt>"""
import pathlib
import re
import subprocess
import sys

print(pathlib.Path(__file__).read_text(encoding="utf-8"))
print("--- run")
root = pathlib.Path(sys.argv[1]).resolve()
rows = []
for line in pathlib.Path(sys.argv[2]).read_text(encoding="utf-8").split("\n"):
    m = re.match(r"^(scripts/\S+\.gd):(\d+) (\S+)$", line)
    if m:
        rows.append((m.group(1), int(m.group(2)), m.group(3)))
tracked = [t for t in subprocess.run(["git", "ls-files"], cwd=root, capture_output=True, text=True, encoding="utf-8").stdout.split("\n") if t]
LOGS = ("docs/RUN_STATE.md", "docs/CORRECTION_LOG.md", "docs/PROOFS.md", "docs/RESUME_NOTE.md", "docs/ORDER_PASS_REPORT.md", "docs/CLEANUP_LEDGER.md", "docs/CLEANUP_LOG.md",
        "docs/CLEANUP_MANIFEST.md", "docs/ABSORB_PLAN.md", "docs/GEMINI_INTEGRATION_REPORT.md", "docs/KNOWN_ISSUES.md")
other = [t for t in tracked if t.endswith((".md", ".py", ".sh", ".yml", ".txt")) and t not in LOGS and not t.startswith(("docs/artifacts/", "docs/stills/"))]
txt = "\n".join((root / t).read_text(encoding="utf-8", errors="replace") for t in other)
keep = ["%s:%d %s" % r for r in rows if not re.search(r"(?<![A-Za-z0-9_])" + re.escape(r[2]) + r"(?![A-Za-z0-9_])", txt)]
pathlib.Path(sys.argv[3]).write_text("\n".join(keep) + "\n", encoding="utf-8")
print("candidates %d, named by no document or tool: %d" % (len(rows), len(keep)))

