"""Session 19, P5: the release keystore's path and password (read from .signing/release.env, never printed) must not occur in the export log,
the verification log or any entry of the bundle outside META-INF (the signature files). Prints itself first and the names of the variables
and the counts only. Arguments: the files to scan, the bundle last."""
import pathlib
import re
import sys
import zipfile

print(pathlib.Path(__file__).read_text(encoding="utf-8"))
print("--- run")
env = pathlib.Path(r"C:\Users\Maxsim\Desktop\TLS_Build\THE_LAST_STREETLIGHT\.signing\release.env").read_text(encoding="utf-8", errors="replace")
secrets = {}
for line in env.splitlines():
    m = re.match(r"\s*(?:export\s+)?([A-Z0-9_]+)=(.*)$", line)
    if m and ("PASSWORD" in m.group(1) or m.group(1).endswith("_PATH")):
        value = m.group(2).strip().strip("'\"")
        if len(value) >= 6:
            secrets[m.group(1)] = value
print("secret variables read: %s" % sorted(secrets))
total = 0
for arg in sys.argv[1:]:
    p = pathlib.Path(arg)
    if p.suffix == ".aab":
        with zipfile.ZipFile(p) as z:
            data = b"".join(z.read(i) for i in z.infolist() if not i.filename.startswith("META-INF/"))
        label = "%s (entries outside META-INF)" % p.name
    else:
        data = p.read_bytes()
        label = p.name
    counts = {k: data.count(v.encode()) for k, v in secrets.items()}
    total += sum(counts.values())
    print("%-60s %s" % (label, counts))
print("secret occurrences=%d" % total)
sys.exit(1 if total or not secrets else 0)

