# cmd bash /c/Users/Maxsim/AppData/Local/Temp/claude/C--Users-Maxsim-Desktop-TLS-Build-THE-LAST-STREETLIGHT/1b7febd1-9c60-4db2-8f84-207d10a1b816/scratchpad/f5_gate_inventory.sh
== script f5_gate_inventory.sh
#!/usr/bin/env bash
# F5 round 9 / CORRECTION_LOG 143: every later edit of the gate and tool files that the pass created (added since e4bb4df under tools, scripts/tools, scenes/tools),
# with its added and removed line counts and the removed lines that are not comments, to be read one by one. Prints the script first.
S="C:/Users/Maxsim/AppData/Local/Temp/claude/C--Users-Maxsim-Desktop-TLS-Build-THE-LAST-STREETLIGHT/1b7febd1-9c60-4db2-8f84-207d10a1b816/scratchpad"
cd C:/Users/Maxsim/Desktop/TLS_Build/THE_LAST_STREETLIGHT || exit 2
echo "== script f5_gate_inventory.sh"
cat "$S/f5_gate_inventory.sh"
echo "== files added since e4bb4df under tools, scripts/tools, scenes/tools"
git diff --name-status --diff-filter=A e4bb4df HEAD -- tools scripts/tools scenes/tools | awk '{print $2}' > "$S/added_gates.txt"
wc -l < "$S/added_gates.txt"
echo "== later edits (created <commit> | edit <commit> <date> <subject> | +added -removed), with the removed non-comment lines"
edits=0; removing=0
while read -r f; do
	commits=$(git log --reverse --format=%h e4bb4df..HEAD -- "$f")
	first=$(echo "$commits" | head -1)
	for c in $(echo "$commits" | tail -n +2); do
		add=$(git show --numstat --format= "$c" -- "$f" | awk '{print $1}')
		rem=$(git show --numstat --format= "$c" -- "$f" | awk '{print $2}')
		edits=$((edits + 1))
		echo "### $f | created $first | edit $c $(git show -s --format='%ad %s' --date=format:'%Y-%m-%dT%H:%M%z' "$c" | cut -c1-110) | +$add -$rem"
		if [ "$rem" != "0" ]; then
			removing=$((removing + 1))
			git show --format= "$c" -- "$f" | grep '^-[^-]' | grep -v '^-\s*\(#\|##\|$\)' | head -8 | cut -c1-200
		fi
	done
done < "$S/added_gates.txt"
echo "== files edited after creation: $(while read -r f; do n=$(git log --format=%h e4bb4df..HEAD -- "$f" | wc -l); [ "$n" -gt 1 ] && echo x; done < "$S/added_gates.txt" | wc -l), edits: $edits, edits that remove lines: $removing"
echo "== the first ledger rows (the timing and probe runs of the harness development and the first evidence runs)"
head -12 docs/artifacts/rc16/launch_ledger.tsv | cut -f1-6
echo "== row 8: its head and the quantity that only 1ac9dd3 adds"
sed -n '2,3p' docs/artifacts/rc16/proofs/timing_before.out
grep -n "player_damage_per_s" docs/artifacts/rc16/proofs/timing_before.out
git show 1ac9dd3^:tools/qa_sim/timing_compare.py | grep -c "player_damage_per_s"
echo "== the probe takes its perf readings before the staged states"
grep -n "await _perf\|await _stage_states" scripts/tools/_rc16_probe_runner.gd
