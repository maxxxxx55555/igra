"""Session 19: the project settings packed in each of the three bundles of the day (v8.0.0 of 63fda65, the first rebuild of 16abbb0, the final one
of e241597): size and CRC of project.binary and of the packed bus layout, and whether the setting audio/buses/default_bus_layout is in it, with its
value. Arguments: the three bundles, oldest first. Prints itself first."""
import pathlib
import re
import sys
import zipfile

print(pathlib.Path(__file__).read_text(encoding="utf-8"))
print("--- run")
for arg in sys.argv[1:]:
    with zipfile.ZipFile(arg) as z:
        infos = {i.filename: i for i in z.infolist()}
        pb_name = next(n for n in infos if n.endswith("/project.binary"))
        pb = z.read(pb_name)
        bus = [n for n in infos if "default_bus_layout" in n and n.endswith(".res")]
    key = b"audio/buses/default_bus_layout"
    value = re.search(rb"uid://[a-z0-9]+|res://[\w./-]*default_bus_layout[\w.]*", pb[pb.find(key):pb.find(key) + 120]) if key in pb else None
    print("%s: project.binary %d bytes CRC %08x; the setting %s%s; bus layout %s" % (
        pathlib.Path(arg).parent.parent.name + "/" + pathlib.Path(arg).name if "_BACKUPS" in arg else arg, infos[pb_name].file_size, infos[pb_name].CRC,
        "present" if key in pb else "absent", (" = " + value.group(0).decode()) if value else "",
        ", ".join("%s %d bytes CRC %08x" % (n.rsplit("/", 1)[-1], infos[n].file_size, infos[n].CRC) for n in bus)))

