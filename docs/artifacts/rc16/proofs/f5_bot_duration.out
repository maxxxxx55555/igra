== script f5_bot_duration.sh
#!/usr/bin/env bash
# F5 round 7 / CORRECTION_LOG 140: (1) the wall time at which the autoplay bot fired the WIN ending, in every bot log of this pass, and its range in minutes;
# (2) the other duration claims about the bot or the play-through in docs, tools and scripts/tools; (3) the number of names in SCREEN_LIST (the SC7 cell).
S="C:/Users/Maxsim/AppData/Local/Temp/claude/C--Users-Maxsim-Desktop-TLS-Build-THE-LAST-STREETLIGHT/1b7febd1-9c60-4db2-8f84-207d10a1b816/scratchpad"
cd C:/Users/Maxsim/Desktop/TLS_Build/THE_LAST_STREETLIGHT || exit 2
echo "== script f5_bot_duration.sh"
cat "$S/f5_bot_duration.sh"
echo "== (1) WIN ending fired; t is wall seconds since the runner started (scripts/tools/_qa_autoplay_runner.gd:119 sets _t0, :139 reads it)"
grep -a "WIN ending fired" docs/artifacts/rc16/proofs/s8_bot_3seeds_f49a5cf.attach.autoplay_seed*.log docs/artifacts/rc16/proofs/s8_bot_counter_21c2046.attach.autoplay_seed*.log
echo "== range"
grep -a -h "WIN ending fired" docs/artifacts/rc16/proofs/s8_bot_3seeds_f49a5cf.attach.autoplay_seed*.log docs/artifacts/rc16/proofs/s8_bot_counter_21c2046.attach.autoplay_seed*.log | python -I -c "
import re, sys
v = [float(re.search(r't=([0-9.]+)', l).group(1)) for l in sys.stdin]
print('runs', len(v), 'min %.1f s = %.2f min, max %.1f s = %.2f min' % (min(v), min(v) / 60, max(v), max(v) / 60))"
echo "== (2) duration claims about the bot, the play-through or a clear in the documents and tools (the corrected cells are the ones with 6.0 to 6.3)"
grep -rn -i "about [0-9]* min\|[0-9]* minutes\|[0-9.]* to [0-9.]* min" --include=*.md --include=*.sh --include=*.py --include=*.gd docs tools scripts/tools | grep -v "docs/artifacts\|docs/stills\|CORRECTION_LOG.md" | grep -i "bot\|autoplay\|play-through\|playthrough\|clear"
echo "== (3) names in SCREEN_LIST (scripts/ui/screens.gd:18)"
python -I -c "
import re
t = open('scripts/ui/screens.gd', encoding='utf-8').read()
m = re.search(r'const SCREEN_LIST: Array\[String\] = \[(.*?)\]', t, re.S)
names = re.findall(r'\"([A-Za-z]+)\"', m.group(1))
print(len(names), 'names:', ', '.join(names))
cards = {'PowerGrid', 'Events', 'Radio', 'StoryScene', 'FinalNight', 'Weather', 'ControlsTouch'}
print(len(cards & set(names)), 'of the seven mock-up cards are in the list')"
echo "== (4) the other figures of the uncited cells of the gap table and of U1 to U8, read against the code (H3.18, AU4, CB3, EC1, M5.4, I9.5, U5, U2)"
echo "-- H3.18: files that mention temperature outside the locale files (expect none)"
rg -i -l temperature scripts scenes data --glob '!data/i18n/**'
echo "-- AU4: surfaces with walk, jog and sprint files (scripts/systems/footstep_system.gd:32)"
python -I -c "
import re
t = open('scripts/systems/footstep_system.gd', encoding='utf-8').read()
m = re.search(r'const SPEED_SURFACES: Array\[String\] = \[(.*?)\]', t, re.S)
print(len(re.findall(r'\"([a-z]+)\"', m.group(1))), 'surfaces')"
echo "-- CB3: the melee query radius"
grep -n "^const MELEE_REACH" scripts/player/player_3d.gd
echo "-- EC1: the reward constants"
grep -n "^const REWARD_" scripts/economy/rewards_manager.gd
echo "-- M5.4: the settings tabs"
grep -c "tab_container.add_child" scripts/ui/settings_screen.gd
echo "-- I9.5: the equipment slots"
grep -c "ItemData.EquipSlot.*: null," scripts/inventory/inventory_manager.gd
echo "-- U5: the pinch pairing window and the zoom limits"
grep -n "^const PINCH_PAIR_MS" scripts/player/player_3d.gd
grep -n "^const ZOOM_M" scripts/core/camera_follow_3d.gd
echo "-- U2: the bundle version code"
grep -n "^version/code" export_presets.cfg
