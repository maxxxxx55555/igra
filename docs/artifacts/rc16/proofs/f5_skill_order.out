== script skill_order.py
"""Order of Skill tool calls and of commits in the session transcript (JSON lines), by line number.

usage: skill_order.py <transcript.jsonl> <from UTC prefix> <commit hash>...
A commit is placed at the first transcript line that holds its hash (the hash cannot exist before the commit does).
"""
import json
import sys
from pathlib import Path

WATCH = {"ponytail", "ponytail-review", "godot-style", "backup-first", "memory-keeper", "arena", "graphify"}
path, since, hashes = Path(sys.argv[1]), sys.argv[2], sys.argv[3:]

events, first = [], {}
with path.open(encoding="utf-8") as f:
    for n, line in enumerate(f, 1):
        for h in hashes:
            if h not in first and h in line:
                first[h] = n
                stamp = line.split('"timestamp":"', 1)[1][:24] if '"timestamp":"' in line else ""
                events.append((n, stamp, "COMMIT", h))
        try:
            o = json.loads(line)
        except ValueError:
            continue
        stamp = o.get("timestamp", "")
        content = (o.get("message") or {}).get("content")
        if stamp < since or not isinstance(content, list):
            continue
        for c in content:
            if isinstance(c, dict) and c.get("type") == "tool_use" and c.get("name") == "Skill":
                skill = (c.get("input") or {}).get("skill", "")
                if skill in WATCH or skill.startswith("omni-"):
                    events.append((n, stamp, "SKILL", skill))

for n, stamp, kind, text in sorted(events):
    print(f"line {n:>6}  {stamp}  {kind:<6} {text}")
print(f"commits not found in the transcript: {[h for h in hashes if h not in first]}")
