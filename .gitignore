# Godot
.godot/
bin/
*.import
*.uid
*.translation

# EXCEPTION (perf(textures) 2026-09-13): committed .import files carry
# non-default compress/mode=2 (VRAM Compressed = ASTC 6x6 on Android /
# ETC2 on GL) + compress/high_quality=true. PSNR-verified >=38dB against
# Lossless originals (docs/TEXTURE_COMPRESSION_REPORT.md). .import is
# normally gitignored (a fresh `--import` regenerates it with engine
# defaults = Lossless); committing them means ASTC survives a clean
# checkout instead of silently reverting. Excludes cards (content ban),
# store/ and docs/ marketing screenshots (non-shipping), and _orphaned.
# Recursive globs (**) cover subdirectories like icons/skills/, icons_v2/craft/,
# renders_v2/weapons/ etc.
!assets/art/*.import
!assets/grading/*.import
!assets/photos/*.import
!assets/textures/**/*.import
assets/textures/cards/*.import

