[sub_resource type="Shader" id="cone_shader"]
resource_local_to_scene = true
code = "shader_type spatial;
render_mode blend_add, unshaded, shadows_disabled;

uniform vec4 cone_color : source_color = vec4(1.0, 0.81, 0.48, 1.0);

void fragment() {
    float along = clamp((VERTEX.y + 1.25) / 2.5, 0.0, 1.0);
    vec3 warm = vec3(1.0, 0.81, 0.48);
    vec3 hot = vec3(1.0, 0.95, 0.82);
    vec3 col = mix(warm, hot, 1.0 - along);
    ALBEDO = col * 2.5;
    ALPHA = (1.0 - along) * 0.85;
}"

