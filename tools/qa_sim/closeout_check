#!/usr/bin/env bash
# rc15 closeout gate: firearms, workbench blueprints, photo album, hiding spots, the visibility model, the
# inventory screen, the achievement triggers, difficulty and the settings Back button, in one headless run of the
# real game scene (scripts/tools/_closeout_check_runner.gd). Under the user-data guard like every QA launch.
#
#   tools/qa_sim/closeout_check          # log -> .qa_logs/closeout_check.log
set -uo pipefail
cd "$(dirname "$0")/../.." || exit 2

GODOT="$(bash tools/qa_sim/_resolve_godot.sh 2>/dev/null)"
if [[ -z "$GODOT" ]] || [[ ! -x "$GODOT" ]]; then
	bash tools/qa_sim/_resolve_godot.sh >&2
	exit 99
fi
source tools/qa_sim/user_data_guard.sh
udg_snapshot || exit 99
trap 'udg_restore || exit 97' EXIT
trap 'exit 130' INT TERM
export TLS_UDG_GUARDED=1
mkdir -p .qa_logs
LOG=.qa_logs/closeout_check.log
rm -f "$LOG"
timeout "${1:-240}" "$GODOT" --headless --path . res://scenes/tools/closeout_check_scene.tscn >"$LOG" 2>&1
rc=$?
source tools/qa_sim/engine_errors.sh
grep -aE "^\[closeout\] (FAIL|DONE)" "$LOG" | tail -40
scan_engine_log "$LOG" 12 || rc=1
echo "  closeout_check rc=$rc (log: $LOG)"
exit $rc
