#!/usr/bin/env bash
# Windowed TZ probe (scenes/tools/tz_verify_scene.tscn) under the user-data
# guard (tools/qa_sim/guarded_windowed). The probe's own in-process snapshot
# is lost if the window is closed or a script error stalls it; the guard's
# trap restores the profile on any exit.
#
#   tools/qa_sim/tz_verify          # frames -> docs/stills/tzverify/, log -> .qa_logs/tz_verify_scene.log
set -uo pipefail
cd "$(dirname "$0")/../.."
bash tools/qa_sim/guarded_windowed res://scenes/tools/tz_verify_scene.tscn 300
rc=$?
grep -E "^\[tzv\] (OK|FAIL|DONE)" .qa_logs/tz_verify_scene.log
exit $rc
