#!/usr/bin/env bash
# rc15 play-through (R0): the real game, played through injected input events with a frame read at every step.
# Three windowed processes on one fresh profile, under the user-data guard (the owner's files are put back at the end):
#   A  boot, difficulty, onboarding, controls, first monster, death, inventory, shop, upgrades, map, battery, tiers, languages
#   V  the bot plays to the victory with frames at the milestones, then New Game+ and Save and quit
#   B  relaunch, Continue (compared with what V saved), the daily card, achievements, hardcore
#
#   tools/qa_sim/playthrough            # A V B S in that order, the profile wiped before A and before S
#   tools/qa_sim/playthrough A          # one mode (the profile is wiped only when A or S runs first)
#   tools/qa_sim/playthrough S          # the screens the others do not open: the Codex tabs, HUD buttons, workbench, credits
#   tools/qa_sim/playthrough L          # the full loop (scripts/tools/_loop_runner.gd): L0 L1 L2 L3 per seed of QA_SEEDS (1 2 3),
#                                       # a fresh profile per seed, a seed stops at its first failed process; frames -> .qa_logs/loop_frames/
#   frames -> docs/stills/playthrough/, steps -> .qa_logs/playthrough_<mode>.txt, engine log -> .qa_logs/playthrough_<mode>.log
set -uo pipefail
cd "$(dirname "$0")/../.." || exit 2
MODES=("$@")
[[ ${#MODES[@]} -gt 0 ]] || MODES=(A V B S)

GODOT="$(bash tools/qa_sim/_resolve_godot.sh 2>/dev/null)"
if [[ -z "$GODOT" ]] || [[ ! -x "$GODOT" ]]; then
	bash tools/qa_sim/_resolve_godot.sh >&2
	exit 99
fi
source tools/qa_sim/user_data_guard.sh
udg_snapshot || exit 99
trap 'udg_restore || exit 97' EXIT
trap 'exit 130' INT TERM
export TLS_UDG_GUARDED=1
mkdir -p .qa_logs docs/stills/playthrough

# a fresh install: no settings, no save, no achievements, no daily state (A and S start from one)
fresh_profile() {
	while IFS= read -r f; do rm -f -- "$UDG_DIR/$f"; done < "$UDG_SNAP/list"
	rm -f .qa_logs/pt_state.json
	echo "  fresh profile: $(wc -l < "$UDG_SNAP/list") game file(s) set aside (restored at the end)"
}
[[ "${MODES[0]}" == "A" || "${MODES[0]}" == "S" ]] && fresh_profile
if [[ "${MODES[0]}" == "L" ]]; then
	MODES=()
	for s in ${QA_SEEDS:-1 2 3}; do MODES+=("L0:$s" "L1:$s" "L2:$s" "L3:$s"); done
	rm -rf .qa_logs/loop_frames
fi

rc_all=0
stopped=""
for MODE in "${MODES[@]}"; do
	[[ "$MODE" == "S" && "${MODES[0]}" != "S" ]] && fresh_profile
	SEED=""
	if [[ "$MODE" == L?:* ]]; then
		SEED="${MODE#*:}"; MODE="${MODE%%:*}"
		[[ " $stopped " == *" $SEED "* ]] && continue
		[[ "$MODE" == "L0" ]] && fresh_profile
	fi
	LOG=".qa_logs/playthrough_$MODE${SEED:+_s$SEED}.log"
	rm -f "$LOG" ".qa_logs/playthrough_$MODE.txt"
	QA_SEED="${SEED:-1}" PT_MODE="$MODE" timeout 1500 "$GODOT" --windowed --path . res://scenes/tools/playthrough_scene.tscn > "$LOG" 2>&1
	rc=$?
	if [[ -n "$SEED" ]]; then
		[[ -f ".qa_logs/playthrough_$MODE.txt" ]] && mv -f ".qa_logs/playthrough_$MODE.txt" ".qa_logs/playthrough_${MODE}_s$SEED.txt"
		last=$(grep -aE "^\[pt\] DONE " "$LOG" | tail -1)
		if [[ $rc -ne 0 || "$last" != *" fails=0 "* ]]; then
			stopped="$stopped $SEED"
			rc_all=1
			echo "  seed $SEED stops at $MODE (rc=$rc, ${last:-no DONE line: a crash or a hang})"
		fi
	fi
	BAD='SCRIPT ERROR|Parse Error|Compile Error|Nonexistent function|freed instance|Failed to load script|Invalid call|Invalid get index|Invalid set index|Cannot infer the type'
	errs=$(grep -aE "$BAD" "$LOG" | head -8)
	echo "  mode $MODE${SEED:+ seed $SEED} rc=$rc (log: $LOG)"
	grep -aE "^\[pt\] (FAIL|DONE)|^\[pt\] PASS C[0-9]|^\[pt\] note HITCH" "$LOG" | tail -30
	if [[ -n "$errs" ]]; then
		echo "engine errors in the log:"
		echo "$errs"
		rc_all=1
	fi
	[[ $rc -eq 0 ]] || rc_all=1
done
exit $rc_all
